  },
  "item": [
    {
      "name": "Auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 & token terbit\", function () {\r\n    pm.response.to.have.status(200);\r\n    var res = pm.response.json();\r\n    pm.expect(res.access_token).to.be.a(\"string\").and.not.empty;\r\n    pm.environment.set(\"jwt_token\", res.access_token);\r\n});\r\npm.test(\"Response time < 5000ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{username}}\", \"password\": \"{{password}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Buat Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 & cart_id terbit\", function () {\r\n    pm.response.to.have.status(201);\r\n    var res = pm.response.json();\r\n    pm.expect(res.id).to.be.a(\"string\").and.not.empty;\r\n    pm.environment.set(\"cart_id\", res.id);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/carts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "carts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add Item",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest(pm.environment.get(\"base_url\") + \"/products\", function (err, res) {\r\n    if (!err) pm.environment.set(\"product_id\", res.json().data[0].id);\r\n});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Item masuk cart\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"product_id\": \"{{product_id}}\", \"quantity\": 1 }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/carts/{{cart_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "carts",
            "{{cart_id}}"
          ]
        }
      },
      "response": []
    },
